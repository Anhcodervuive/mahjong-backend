generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// 1. AUTHENTICATION, MEDIA, AND CMS
// ------------------------------------------------------
enum BookingType {
  TRAINING
  GUIDED_GAME
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)
}

model Media {
  id           Int      @id @default(autoincrement())
  filename     String
  originalName String
  mimeType     String
  size         Int
  path         String
  createdAt    DateTime @default(now())
}

model CmsPage {
  id       Int          @id @default(autoincrement())
  slug     String       @unique // e.g., "home", "about", "faq"
  title    String // E.g., "Trang chủ"
  sections CmsSection[]

  metaUrl                String?
  metaTitle              String?
  metaKeyword            String?
  metaDescription        String?
  ogMetaTitle            String?
  ogMetaDescription      String?
  twitterMetaTitle       String?
  twitterMetaDescription String?
}

model CmsSection {
  id      Int     @id @default(autoincrement())
  pageId  Int
  key     String
  name    String?
  content Json
  order   Int     @default(0)

  page CmsPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, key])
}

// ------------------------------------------------------
// 2. PRODUCT HIERARCHY
// ------------------------------------------------------
model Game {
  id           Int     @id @default(autoincrement())
  name         String // e.g., International Goulash, American
  description  String?
  coverImageId Int? // Links to Media.id implicitly (no hard relation needed for simplicity)
  iconImageId  Int?
  order        Int     @default(0)

  categories SessionCategory[]

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  isDeleted Boolean     @default(false)
  type      BookingType @default(TRAINING)

  joinCircleRequests JoinCircleRequest[]
}

model SessionCategory {
  id          Int     @id @default(autoincrement())
  gameId      Int
  name        String // e.g., Levels, Guided Play
  description String?
  order       Int     @default(0)

  game     Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  sessions Session[]

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  isDeleted Boolean     @default(false)
  type      BookingType @default(TRAINING)
}

model Session {
  id         Int  @id @default(autoincrement())
  categoryId Int
  parentId   Int? // Self-reference for modules

  title          String
  subtitle       String?
  description    String?
  thumbnailId    Int? // Link to Media.id
  pricePerPerson Decimal @db.Decimal(10, 2)
  duration       Int // Duration in minutes
  minPlayers     Int     @default(1)
  maxPlayers     Int
  order          Int     @default(0)

  // Relations
  category SessionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  parent   Session?        @relation("SessionToSession", fields: [parentId], references: [id], onDelete: Cascade)
  children Session[]       @relation("SessionToSession")

  bookings Booking[]

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  isDeleted Boolean     @default(false)
  type      BookingType @default(TRAINING)
}

// ------------------------------------------------------
// 3. SERVICE OPTIONS & PRICING
// ------------------------------------------------------
model ServiceOption {
  id          Int     @id @default(autoincrement())
  name        String // e.g., Regular, Premium
  description String?
  price       Decimal @default(0) @db.Decimal(10, 2)

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)
}

// ------------------------------------------------------
// 3b. LOCATIONS
// ------------------------------------------------------
model Location {
  id          Int     @id @default(autoincrement())
  name        String // e.g., Studio 1, User Location
  description String?
  address     String?
  mapUrl      String?
  price       Decimal @default(0) @db.Decimal(10, 2)
  parking     String? // e.g., "Free parking available"
  order       Int     @default(0)
  isDeleted   Boolean @default(false)

  bookings           Booking[]
  joinCircleRequests JoinCircleRequest[] @relation("JoinCircleRequestToLocation")
  schedules          LocationSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LocationSchedule {
  id         Int    @id @default(autoincrement())
  locationId Int
  dayOfWeek  Int // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime  String // e.g., "10:00"
  endTime    String // e.g., "22:00"
  capacity   Int    @default(8)

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locationId, dayOfWeek, startTime, endTime])
}

// ------------------------------------------------------
// 4. CALENDAR & AVAILABILITY
// ------------------------------------------------------
model WeeklySchedule {
  id        Int    @id @default(autoincrement())
  dayOfWeek Int // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime String // e.g., "10:00"
  endTime   String // e.g., "22:00"
  capacity  Int    @default(4) // e.g., 4 tables

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dayOfWeek, startTime, endTime])
}

model DateOverride {
  id              Int      @id @default(autoincrement())
  date            DateTime @db.Date
  isClosed        Boolean  @default(false)
  customStartTime String? // e.g., "10:00"
  customEndTime   String? // e.g., "15:00"
  customCapacity  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date])
}

// ------------------------------------------------------
// 5. BOOKINGS & PARTICIPANTS
// ------------------------------------------------------
model AgeGroup {
  id           Int           @id @default(autoincrement())
  name         String
  participants Participant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)
}

enum BookingStatus {
  PENDING
  SUCCESS
  FAILED
}

model Booking {
  id              Int  @id @default(autoincrement())
  sessionId       Int
  serviceOptionId Int
  locationId      Int?

  bookingDate DateTime @db.Date
  startTime   String // e.g. "10:00"
  endTime     String // e.g. "12:00"

  contactName  String
  contactEmail String
  contactPhone String

  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int
  totalAmount Decimal @db.Decimal(10, 2)

  status BookingStatus @default(PENDING)

  session       Session       @relation(fields: [sessionId], references: [id])
  serviceOption ServiceOption @relation(fields: [serviceOptionId], references: [id])
  location      Location?     @relation(fields: [locationId], references: [id])

  participants Participant[]
  payment      Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)
}

model Participant {
  id         Int @id @default(autoincrement())
  bookingId  Int
  ageGroupId Int

  fullName String
  email    String?
  phone    String?
  isOwner  Boolean @default(false)

  booking  Booking  @relation(fields: [bookingId], references: [id])
  ageGroup AgeGroup @relation(fields: [ageGroupId], references: [id])

  createdAt DateTime @default(now())
}

// ------------------------------------------------------
// 6. PAYMENTS
// ------------------------------------------------------
enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Payment {
  id            Int           @id @default(autoincrement())
  bookingId     Int           @unique
  provider      String
  transactionId String?       @unique
  paymentUrl    String?
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("AED")
  status        PaymentStatus @default(PENDING)

  booking Booking @relation(fields: [bookingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)
}

// ------------------------------------------------------
// 7. INQUIRIES & REQUESTS
// ------------------------------------------------------
enum JoinCircleStatus {
  PENDING
  CONTACTED
  COMPLETED
}

model JoinCircleRequest {
  id          Int      @id @default(autoincrement())
  firstName   String
  lastName    String
  email       String
  phone       String
  gameId      Int
  level       String
  ageGroup    String
  days        String[]
  times       String[]
  groupSize   String
  message     String?
  friendEmail String?
  friendPhone String?

  status JoinCircleStatus @default(PENDING)

  game     Game      @relation(fields: [gameId], references: [id])
  locations Location[] @relation("JoinCircleRequestToLocation")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)
}
