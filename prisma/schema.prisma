generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------
// 1. AUTHENTICATION & MEDIA
// ------------------------------------------------------
enum Role {
  USER
  ADMIN
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Media {
  id           Int      @id @default(autoincrement())
  filename     String
  originalName String
  mimeType     String
  size         Int
  path         String
  createdAt    DateTime @default(now())
}

// ------------------------------------------------------
// 2. PRODUCT HIERARCHY
// ------------------------------------------------------
model Game {
  id          Int               @id @default(autoincrement())
  name        String            // e.g., International Goulash, American
  description String?
  categories  SessionCategory[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model SessionCategory {
  id          Int       @id @default(autoincrement())
  gameId      Int
  name        String    // e.g., Levels, Guided Play
  description String?
  game        Game      @relation(fields: [gameId], references: [id])
  sessions    Session[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Session {
  id             Int       @id @default(autoincrement())
  categoryId     Int
  parentId       Int?      // Self-reference for modules
  
  title          String
  subtitle       String?
  description    String?
  pricePerPerson Decimal   @db.Decimal(10, 2)
  duration       Int       // Duration in minutes
  minPlayers     Int       @default(1)
  maxPlayers     Int
  
  // Relations
  category       SessionCategory @relation(fields: [categoryId], references: [id])
  parent         Session?        @relation("SessionToSession", fields: [parentId], references: [id])
  children       Session[]       @relation("SessionToSession")
  
  serviceOptions SessionServicePricing[]
  bookings       Booking[]
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ------------------------------------------------------
// 3. SERVICE OPTIONS & PRICING
// ------------------------------------------------------
model ServiceOption {
  id          Int       @id @default(autoincrement())
  name        String    // e.g., Regular, Premium
  description String?
  
  sessionPricing SessionServicePricing[]
  bookings       Booking[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model SessionServicePricing {
  id              Int           @id @default(autoincrement())
  sessionId       Int
  serviceOptionId Int
  price           Decimal       @db.Decimal(10, 2) 
  
  session         Session       @relation(fields: [sessionId], references: [id])
  serviceOption   ServiceOption @relation(fields: [serviceOptionId], references: [id])

  @@unique([sessionId, serviceOptionId])
}

// ------------------------------------------------------
// 4. CALENDAR & AVAILABILITY
// ------------------------------------------------------
model ScheduleDate {
  id        Int        @id @default(autoincrement())
  date      DateTime   @db.Date
  isClosed  Boolean    @default(false)
  
  timeSlots TimeSlot[]
  
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  
  @@unique([date])
}

model TimeSlot {
  id             Int          @id @default(autoincrement())
  scheduleDateId Int
  startTime      DateTime     @db.Time
  endTime        DateTime     @db.Time
  capacity       Int          
  bookedCount    Int          @default(0) 
  
  scheduleDate   ScheduleDate @relation(fields: [scheduleDateId], references: [id])
  bookings       Booking[]
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ------------------------------------------------------
// 5. BOOKINGS & PARTICIPANTS
// ------------------------------------------------------
model AgeGroup {
  id           Int           @id @default(autoincrement())
  name         String        
  participants Participant[]
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Booking {
  id              Int           @id @default(autoincrement())
  sessionId       Int
  timeSlotId      Int
  serviceOptionId Int
  
  contactName     String
  contactEmail    String
  contactPhone    String
  
  unitPrice       Decimal       @db.Decimal(10, 2)
  quantity        Int           
  totalAmount     Decimal       @db.Decimal(10, 2) 
  
  status          BookingStatus @default(PENDING)
  
  session         Session       @relation(fields: [sessionId], references: [id])
  timeSlot        TimeSlot      @relation(fields: [timeSlotId], references: [id])
  serviceOption   ServiceOption @relation(fields: [serviceOptionId], references: [id])
  
  participants    Participant[]
  payment         Payment?
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Participant {
  id          Int      @id @default(autoincrement())
  bookingId   Int
  ageGroupId  Int
  
  fullName    String
  email       String?
  phone       String?
  isOwner     Boolean  @default(false) 
  
  booking     Booking  @relation(fields: [bookingId], references: [id])
  ageGroup    AgeGroup @relation(fields: [ageGroupId], references: [id])
  
  createdAt   DateTime @default(now())
}

// ------------------------------------------------------
// 6. PAYMENTS
// ------------------------------------------------------
enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Payment {
  id            Int           @id @default(autoincrement())
  bookingId     Int           @unique
  provider      String        
  transactionId String?       @unique
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("AED")
  status        PaymentStatus @default(PENDING)
  
  booking       Booking       @relation(fields: [bookingId], references: [id])
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}
